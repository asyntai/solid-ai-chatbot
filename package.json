{
  "name": "solid-ai-chatbot",
  "version": "1.0.0",
  "description": "Add the Asyntai AI chat assistant to any Solid or SolidStart app with one component. It answers visitor questions from your own content, in 80+ languages.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "solid",
    "solidjs",
    "solid-js",
    "solid-start",
    "solidstart",
    "chatbot",
    "ai-chatbot",
    "ai",
    "chat",
    "chat-widget",
    "live-chat",
    "customer-support",
    "asyntai"
  ],
  "homepage": "https://asyntai.com/documentation/integrations/solid/",
  "bugs": {
    "url": "https://github.com/asyntai/solid-ai-chatbot/issues",
    "email": "hello@asyntai.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyntai/solid-ai-chatbot.git"
  },
  "author": "Asyntai <hello@asyntai.com> (https://asyntai.com)",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "test": "node --conditions=browser --test tests/test_component.js"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "solid-js": "^1.9.0"
  }
}
